r_count":0,"following_count":0,"location":null,"name":"Julio Cesar","img_url":"https://s3-alpha.figma.com/profile/1646001732196100824/043db1b6-aea6-4baa-9c54-0dce52b8b8ea","img_urls":{"120_120":"https://s3-alpha.figma.com/profile/1646001732196100824/043db1b6-aea6-4baa-9c54-0dce52b8b8ea","500_500":"https://s3-alpha.figma.com/profile/1646001732196100824/5699abf1-72a5-40d3-a5ea-8742c1e141fa"},"current_user_is_following":null,"current_user_is_followed":null,"is_restricted_by_current_user":null,"realtime_token":"/profile-1646001732319806350:1789012849:0:0a82622374bc19409f9c5fe4638a9aa92d75377d","entity_type":"user","associated_users":[{"user_id":"1646001732196100824","is_primary_user":true}],"description":null,"badges":[]}]},"community_creators":{"accepted":[{"id":"1646001732319806350","profile_handle":"juliocesar73","primary_user_id":"1646001732196100824","public_at":"2026-09-04T20:13:40.294Z","created_at":"2026-06-09T02:23:14.213Z","follower_count":0,"following_count":0,"location":null,"name":"Julio Cesar","img_url":"https://s3-alpha.figma.com/profile/1646001732196100824/043db1b6-aea6-4baa-9c54-0dce52b8b8ea","img_urls":{"120_120":"https://s3-alpha.figma.com/profile/1646001732196100824/043db1b6-aea6-4baa-9c54-0dce52b8b8ea","500_500":"https://s3-alpha.figma.com/profile/1646001732196100824/5699abf1-72a5-40d3-a5ea-8742c1e141fa"},"current_user_is_following":null,"current_user_is_followed":null,"is_restricted_by_current_user":null,"realtime_token":"/profile-1646001732319806350:1789012849:0:0a82622374bc19409f9c5fe4638a9aa92d75377d","entity_type":"user","associated_users":[{"user_id":"1646001732196100824","is_primary_user":true}],"description":null,"badges":[]}]},"community_copublishers":null,"icon_url":"https://www.figma.com/community/resource/04c7f7ff-0ec7-4be5-b224-9d855761b450/icon?fuid=1666382703778278399","view_count":0,"like_count":2,"user_count":55,"org_admin_recommended":false,"workspace_admin_recommended":false},{"id":"62a9ba6a-1a72-47fa-bcb3-c814b1c7c432","name":"ABRP — A Better Roadmap Planner","description":"<p>Most Figma roadmaps are just drawings. You place every task by hand — then the moment a date slips or an estimate changes, you spend twenty minutes nudging everything back into place. The plan is out of date the second you finish it.</p><p><br></p><p>ABRP works differently. Every task is measured in working days, not pixels. The board figures out the positions for you — so it stays correct on its own.</p><p><br></p><p>Change one estimate and every task after it slides over. Add a company holiday and the whole timeline breathes around it. Reassign someone and their lane recalculates. You plan the work; ABRP keeps the calendar honest.</p><p><br></p><p>✨ What you get</p><p><br></p><p>🔄 Live reflow — one change ripples through the entire board, no manual dragging</p><p>🗓️ Working-day scheduling — weekends and holidays are respected everywhere, automatically</p><p>👥 Per-person lanes — see who's doing what, and when, at a glance</p><p>🏷️ Custom stages &amp; statuses — rename and recolor them to match how your team really works</p><p>📌 Pin tasks to a fixed date when a deadline is truly locked</p><p>🌗 Light &amp; dark boards to fit any file</p><p><br></p><p>Perfect for sprint planning, product roadmaps, project timelines, launch plans, and team capacity — right inside Figma and FigJam, where your team already works.</p><p><br></p><p>Drop it on any canvas, add your people, and start planning. The timeline takes care of itself.</p>","resource_type":"widget","created_at":"2026-09-04T21:31:14.852Z","updated_at":"2026-09-05T16:58:33.421Z","unpublished_at":null,"support_contact":"ocurancez@gmail.com","publishing_status":"approved_public","publish_scope":"community","editor_types":["design","whiteboard"],"category_id":"819e9cc5-8a9c-4ca4-9932-498d3f58022b","category":null,"creator":{"id":"667997768347561216","handle":"Jircules","img_url":"https://s3-alpha.figma.com/profile/667997768347561216/377cbbc1-600f-4379-a238-697797c84157"},"p