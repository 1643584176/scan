restricted_by_current_user":null,"realtime_token":"/profile-873705841212200711:1789012849:0:92aebc518447fb7e24a1a5c09e71bbd3bf2afe0c","entity_type":"user","associated_users":[{"user_id":"873705841176542496","is_primary_user":true}],"description":"UX Designer","badges":[]}]},"community_copublishers":null,"icon_url":"https://www.figma.com/community/resource/f68f75c8-8ba8-46f9-bb5b-bfa924f13fe3/icon?fuid=1666382703778278399","view_count":0,"like_count":1,"user_count":2,"org_admin_recommended":false,"workspace_admin_recommended":false},{"id":"04c7f7ff-0ec7-4be5-b224-9d855761b450","name":"TeddyTimer","description":"<p>Meet TeddyTimer, your pixel-art companion for focus sessions and little breaks in Figma. FOCUS Set your work and break durations. A countdown stays beside Teddy while you work. When focus time ends, he runs over with a beer and keeps you company during your break. Pause or resume whenever you need. PLAY Choose the tennis ball for Fetch, or turn over rocks in Treasures to find ten matching pairs of dog toys and treats. COMPANION Click Teddy to follow your cursor. Click away and he stays. He curls up after a few quiet minutes; click to wake him. This update introduces a simpler pixel-style menu in forest green and lime, with fewer controls and a countdown for both focus and break sessions. Keep the widget running for timers and animations. Cursor-based features depend on editor support.</p>","resource_type":"widget","created_at":"2026-09-05T02:15:50.302Z","updated_at":"2026-09-08T22:16:21.853Z","unpublished_at":null,"support_contact":"julio.cesar@madeinhaus.com","publishing_status":"approved_public","publish_scope":"community","editor_types":["design","whiteboard"],"category_id":"363ca26d-35f7-49c7-9f1d-5a9c41b12abd","category":null,"creator":{"id":"1646001732196100824","handle":"Julio Cesar","img_url":"https://s3-alpha.figma.com/profile/1646001732196100824/043db1b6-aea6-4baa-9c54-0dce52b8b8ea"},"publisher":{"id":"1646001732319806350","profile_handle":"julioc